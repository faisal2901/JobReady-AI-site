# ── JobReady AI environment variables ──
# Add BOTH of these in Vercel → Project → Settings → Environment Variables

# 1. Google Gemini API key (FREE)
#    Get it at: https://aistudio.google.com/apikey  (click "Create API key")
GEMINI_API_KEY=your_gemini_key_here

# 2. RapidAPI key for JSearch jobs API (FREE tier)
#    Get it at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
#    Sign up → Subscribe to FREE "Basic" plan → copy "X-RapidAPI-Key"
RAPIDAPI_KEY=your_rapidapi_key_here
