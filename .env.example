# ── JobReady AI environment variables ──
# Add BOTH of these in Vercel → Project → Settings → Environment Variables

# 1. Google Gemini API key (FREE)
#    Get it at: https://aistudio.google.com/apikey  (click "Create API key")
GEMINI_API_KEY=your_gemini_key_here

# 2. RapidAPI key for JSearch jobs API (FREE tier)
#    Get it at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
#    Sign up → Subscribe to FREE "Basic" plan → copy "X-RapidAPI-Key"
RAPIDAPI_KEY=your_rapidapi_key_here

# 3. Upstash Redis (recommended for durable credits, referrals, rate limits, analytics)
UPSTASH_REDIS_REST_URL=your_upstash_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 4. Admin-only diagnostics and dashboard protection
ADMIN_TOKEN=make_a_long_random_admin_token

# 5. Optional hard allowlist for production origins, comma separated
ALLOWED_ORIGINS=https://jobtopper.vercel.app
